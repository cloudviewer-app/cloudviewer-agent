#!/bin/sh
# shellcheck shell=sh
# Cloud Viewer agent config renderer — the host side of the config trust
# boundary: THE FACADE SENDS PARAMETERS, THE HOST RENDERS THE CONFIG.
#
# Input is the facade's flat key=value parameter manifest (usage:
# render-config <manifest-file>; rendered vector.yaml on stdout). The
# manifest is validated against a strict schema first — known keys only,
# known values only, reject on anything else — so a compromised
# facade/portal/DB can at worst flip the documented toggles below. It can
# never introduce component types, paths, sinks, VRL, or code: every
# structural byte of the rendered config lives in THIS file, shipped by the
# package, changed only through the operator's own update channel.
#
# The agent token and facade URL are injected locally (env, or agent.env in
# CV_AGENT_ETC_DIR) — they never travel inside a server document.
#
# Schema (manifest_version=1):
#   manifest_version  literal "1"
#   tier              free | pro | team          (comment only)
#   ships_journald    true | false               (journald source + redaction)
#   ships_auth_logs   true | false               (auth-log source; implies journald)
set -eu

fail() {
    printf 'cloudviewer-agent: invalid manifest: %s\n' "$*" >&2
    exit 1
}

[ $# -eq 1 ] || {
    echo "usage: render-config <manifest-file>" >&2
    exit 2
}
[ -r "$1" ] || fail "cannot read $1"

# ---- validate ---------------------------------------------------------------

MANIFEST_VERSION=""
TIER=""
SHIPS_JOURNALD=""
SHIPS_AUTH_LOGS=""

while IFS= read -r line || [ -n "$line" ]; do
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
    manifest_version)
        [ -z "$MANIFEST_VERSION" ] || fail "duplicate key manifest_version"
        MANIFEST_VERSION="$val"
        ;;
    tier)
        [ -z "$TIER" ] || fail "duplicate key tier"
        TIER="$val"
        ;;
    ships_journald)
        [ -z "$SHIPS_JOURNALD" ] || fail "duplicate key ships_journald"
        SHIPS_JOURNALD="$val"
        ;;
    ships_auth_logs)
        [ -z "$SHIPS_AUTH_LOGS" ] || fail "duplicate key ships_auth_logs"
        SHIPS_AUTH_LOGS="$val"
        ;;
    *)
        fail "unknown key '$key'"
        ;;
    esac
done <"$1"

[ "$MANIFEST_VERSION" = "1" ] || fail "unsupported manifest_version '$MANIFEST_VERSION' (this agent understands 1 — update the package)"
case "$TIER" in free | pro | team) ;; *) fail "unknown tier '$TIER'" ;; esac
case "$SHIPS_JOURNALD" in true | false) ;; *) fail "ships_journald must be true or false" ;; esac
case "$SHIPS_AUTH_LOGS" in true | false) ;; *) fail "ships_auth_logs must be true or false" ;; esac
if [ "$SHIPS_AUTH_LOGS" = "true" ] && [ "$SHIPS_JOURNALD" = "false" ]; then
    fail "ships_auth_logs without ships_journald (facade never emits this shape)"
fi

# ---- local identity ---------------------------------------------------------

ETC_DIR="${CV_AGENT_ETC_DIR:-/etc/cloudviewer-agent}"
if [ -z "${CV_AGENT_TOKEN:-}" ] && [ -r "$ETC_DIR/agent.env" ]; then
    # shellcheck disable=SC1091 # written by `cloudviewer-agent enroll`
    . "$ETC_DIR/agent.env"
fi
TOKEN="${CV_AGENT_TOKEN:-}"
BASE="${CV_AGENT_FACADE_URL:-}"
[ -n "$TOKEN" ] || fail "no agent token (CV_AGENT_TOKEN or $ETC_DIR/agent.env)"
[ -n "$BASE" ] || fail "no facade URL (CV_AGENT_FACADE_URL or $ETC_DIR/agent.env)"
DATA_DIR="${CV_AGENT_DATA_DIR:-/var/lib/cloudviewer-agent}"

# ---- render -----------------------------------------------------------------
# The redaction VRL below is pinned byte-for-byte against the facade's rule
# table (facade TestRedactVRLParity + this repo's golden fixtures): the
# same rules run again at ingest, so hosts on an older package are still
# covered server-side. Patterns write apostrophes as \x27 (a literal '
# would end the VRL raw string) and contain no $ (Vector env
# interpolation) — the quoted heredocs below preserve them verbatim.

cat <<EOF
# Cloud Viewer agent configuration — rendered locally by cloudviewer-agent
# from the facade's parameter manifest (tier: $TIER), do not edit.
# The config poller re-renders this file when the manifest changes. The
# facade sends parameters, never config or code (specs/17 §4).

data_dir: $DATA_DIR

sources:
  host_metrics:
    type: host_metrics
    collectors: [cpu, memory, disk, filesystem, load, network]
    scrape_interval_secs: 30
EOF

if [ "$SHIPS_JOURNALD" = "true" ]; then
    cat <<'EOF'

  journald_warnings:
    type: journald
    include_matches:
      PRIORITY: ["0", "1", "2", "3", "4"]
EOF
fi

if [ "$SHIPS_AUTH_LOGS" = "true" ]; then
    cat <<'EOF'

  auth_logs:
    type: file
    include:
      - /var/log/auth.log
      - /var/log/secure
EOF
fi

if [ "$SHIPS_JOURNALD" = "true" ]; then
    cat <<'EOF'

transforms:
  redact_journald:
    type: remap
    inputs: [journald_warnings]
    source: |
      .cv_source = "journald_warnings"
      .message = to_string(.message) ?? ""
      .message = replace(.message, r'(?i)authorization["\x27]?[ \t]*[:=][ \t]*["\x27]?(basic[ \t]+|bearer[ \t]+)?[^\s"\x27]+', "authorization: [REDACTED]")
      .message = replace(.message, r'(?i)bearer[ \t]+[A-Za-z0-9._~+/-]+=*', "bearer [REDACTED]")
      .message = replace(.message, r'(?i)password[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "password=[REDACTED]")
      .message = replace(.message, r'(?i)passwd[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "passwd=[REDACTED]")
      .message = replace(.message, r'(?i)secret[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "secret=[REDACTED]")
      .message = replace(.message, r'(?i)token[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "token=[REDACTED]")
      .message = replace(.message, r'(?i)key[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "key=[REDACTED]")
      .message = replace(.message, r'(?s)-----BEGIN[ A-Z]*PRIVATE KEY-----.*?(-----END[ A-Z]*PRIVATE KEY-----|\z)', "[REDACTED PEM]")
EOF
fi

if [ "$SHIPS_AUTH_LOGS" = "true" ]; then
    cat <<'EOF'

  redact_auth:
    type: remap
    inputs: [auth_logs]
    source: |
      .cv_source = "auth_logs"
      .message = to_string(.message) ?? ""
      .message = replace(.message, r'(?i)authorization["\x27]?[ \t]*[:=][ \t]*["\x27]?(basic[ \t]+|bearer[ \t]+)?[^\s"\x27]+', "authorization: [REDACTED]")
      .message = replace(.message, r'(?i)bearer[ \t]+[A-Za-z0-9._~+/-]+=*', "bearer [REDACTED]")
      .message = replace(.message, r'(?i)password[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "password=[REDACTED]")
      .message = replace(.message, r'(?i)passwd[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "passwd=[REDACTED]")
      .message = replace(.message, r'(?i)secret[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "secret=[REDACTED]")
      .message = replace(.message, r'(?i)token[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "token=[REDACTED]")
      .message = replace(.message, r'(?i)key[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "key=[REDACTED]")
      .message = replace(.message, r'(?s)-----BEGIN[ A-Z]*PRIVATE KEY-----.*?(-----END[ A-Z]*PRIVATE KEY-----|\z)', "[REDACTED PEM]")
EOF
fi

cat <<EOF

sinks:
  cloudviewer_metrics:
    type: http
    inputs: [host_metrics]
    uri: $BASE/v1/ingest/metrics
    method: post
    encoding:
      codec: text
    framing:
      method: newline_delimited
    request:
      headers:
        X-Agent-Token: $TOKEN
EOF

if [ "$SHIPS_JOURNALD" = "true" ]; then
    inputs="[redact_journald]"
    [ "$SHIPS_AUTH_LOGS" = "true" ] && inputs="[redact_journald, redact_auth]"
    cat <<EOF

  cloudviewer_logs:
    type: http
    inputs: $inputs
    uri: $BASE/v1/ingest/logs
    method: post
    encoding:
      codec: json
    framing:
      method: newline_delimited
    request:
      headers:
        X-Agent-Token: $TOKEN
EOF
fi
