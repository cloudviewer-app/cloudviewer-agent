#!/bin/sh
# shellcheck shell=sh
# Cloud Viewer fleet enrollment (specs/12 §3) — the ONE implementation,
# shared by the ctl (`cloudviewer-agent enroll --enroll-token`) and the
# container entrypoint: read this server's numeric Hetzner id from the
# link-local metadata service, self-register with the facade, and print
# the minted per-server token on stdout. The enrollment token is used for
# exactly this one call — it enrolls, it never ingests, and it is never
# written to disk (specs/12 §9).
#
# The instance id is self-asserted — the FACADE verifies it against the
# enrollment token's project inventory before trusting the link; our only
# job is to fetch it and fail closed on garbage.
#
# Environment:
#   CV_AGENT_ENROLL_TOKEN   fleet enrollment token (required)
#   CV_AGENT_FACADE_URL     facade base URL (required)
#   CV_AGENT_METADATA_URL   instance-id endpoint override (tests; default
#                           is the Hetzner Cloud link-local service)
#
# stdout: the minted per-server token. stderr: friendly errors. Exit 1 on
# any failure, with nothing enrolled half-way (the facade call is the only
# side effect, and it is idempotent).
set -eu

METADATA_URL_DEFAULT="http://169.254.169.254/hetzner/v1/metadata/instance-id"

fail() {
    printf 'cloudviewer-agent: error: %s\n' "$*" >&2
    exit 1
}

enroll_tok="${CV_AGENT_ENROLL_TOKEN:-}"
facade="${CV_AGENT_FACADE_URL:-}"
[ -n "$enroll_tok" ] || fail "fleet-enroll: CV_AGENT_ENROLL_TOKEN is not set"
[ -n "$facade" ] || fail "fleet-enroll: CV_AGENT_FACADE_URL is not set"

meta_url="${CV_AGENT_METADATA_URL:-$METADATA_URL_DEFAULT}"
# -m 2: link-local — it answers within milliseconds or not at all
# (dedicated servers, non-Hetzner hosts, blocked link-local routes; in
# Kubernetes, a pod without hostNetwork cannot reach it either).
INSTANCE_ID="$(curl -fsS -m 2 "$meta_url" 2>/dev/null)" || INSTANCE_ID=""
[ -n "$INSTANCE_ID" ] ||
    fail "cannot read the Hetzner Cloud metadata service ($meta_url) —
fleet enrollment identifies this server by its instance id, which only
Hetzner Cloud servers can provide; dedicated (Robot) servers use a
per-server token (--token / CV_AGENT_TOKEN) from the portal instead
(in Kubernetes, the DaemonSet needs hostNetwork to reach the service)"
# Fail-closed: anything but a plain 1-20 digit id (an error page, a
# captive portal, an impostor endpoint) must not travel to the facade.
# A whole-string check, not a line match — a newline is "not a digit".
case "$INSTANCE_ID" in
*[!0-9]*) fail "the metadata service at $meta_url did not return an instance id — refusing fleet enrollment" ;;
esac
[ "${#INSTANCE_ID}" -le 20 ] ||
    fail "the metadata service at $meta_url did not return an instance id — refusing fleet enrollment"

# Hostname is advisory (default display name in the portal). It is
# interpolated into a JSON string, so a hostname containing a double
# quote or backslash would need escaping machinery — instead of carrying
# that for a hostname nobody legitimately has, just omit the optional
# field and let the portal fall back to the inventory name.
host="$(uname -n)"
case "$host" in
*\"* | *\\* | "") body="{\"instance_id\":\"$INSTANCE_ID\"}" ;;
*) body="{\"instance_id\":\"$INSTANCE_ID\",\"hostname\":\"$host\"}" ;;
esac

resp="$(mktemp)"
trap 'rm -f "$resp"' EXIT
http_status="$(curl -sS -o "$resp" -w '%{http_code}' -X POST \
    -H "X-Agent-Enroll-Token: $enroll_tok" \
    -H "Content-Type: application/json" \
    --data "$body" "$facade/v1/agent/enroll")" ||
    fail "cannot reach the facade at $facade"
case "$http_status" in
200) ;;
401)
    fail "the facade does not know this enrollment token — copy it exactly as shown in the portal (Add server → Fleet enrollment)"
    ;;
403)
    # The facade distinguishes revoked tokens from a reached server cap
    # in the body; pass its wording through rather than guessing.
    fail "enrollment refused: revoked or server limit reached — the facade said: $(cat "$resp")"
    ;;
404)
    fail "this server (instance $INSTANCE_ID) is not in the token's project inventory — check the project the token was minted for"
    ;;
*)
    fail "unexpected response from the facade enroll endpoint (HTTP $http_status)"
    ;;
esac

# Extract the minted per-server token. The response is the facade's own
# controlled JSON (never third-party data), so a targeted sed on the
# "token" member — tolerating whitespace around the colon — is sufficient
# and keeps this dependency-free; fail-closed if the shape ever surprises.
TOKEN="$(sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$resp")"
[ -n "$TOKEN" ] ||
    fail "the facade's enroll response did not contain a token — refusing to continue"
printf '%s\n' "$TOKEN"
