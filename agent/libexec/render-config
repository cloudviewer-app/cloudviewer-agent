#!/bin/sh
# shellcheck shell=sh
# Cloud Viewer agent config renderer — the host side of the config trust
# boundary: THE FACADE SENDS PARAMETERS, THE HOST RENDERS THE CONFIG.
#
# Input is the facade's flat key=value parameter manifest (usage:
# render-config <manifest-file>; rendered vector.yaml on stdout). The
# manifest is validated against a strict schema first — known keys only,
# known values only, reject on anything else — so a compromised
# facade/portal/DB can at worst flip the documented toggles below. It can
# never introduce component types, paths, sinks, VRL, or code: every
# structural byte of the rendered config lives in THIS file, shipped by the
# package, changed only through the operator's own update channel.
#
# The agent token and facade URL are injected locally (env, or agent.env in
# CV_AGENT_ETC_DIR) — they never travel inside a server document.
#
# Schema (manifest_version 1 or 2):
#   manifest_version   literal "1" or "2"
#   tier               free | pro | team         (comment only)
#   ships_journald     true | false              (journald source + redaction)
#   ships_auth_logs    true | false              (auth-log source; implies journald)
#   ships_disk_health  true | false              (version 2 only, and required
#                                                 there: SMART + mdstat shipping,
#                                                 specs/44 §3.2)
#
# ships_disk_health is the only lever the facade has over disk health, and
# it is deliberately weak: it decides whether Vector READS what the
# operator-enabled root collector already wrote. The exec source it adds
# runs one fixed, unprivileged helper — the literal path below, never a
# manifest value — and only when that helper is installed. It cannot
# enable the collector, change smartctl's arguments, or name a device,
# path or command. (Test override: CV_AGENT_LIBEXEC_DIR moves where the
# helper's EXISTENCE is checked; the rendered command stays the literal.)
set -eu

fail() {
    printf 'cloudviewer-agent: invalid manifest: %s\n' "$*" >&2
    exit 1
}

[ $# -eq 1 ] || {
    echo "usage: render-config <manifest-file>" >&2
    exit 2
}
[ -r "$1" ] || fail "cannot read $1"

# ---- validate ---------------------------------------------------------------

MANIFEST_VERSION=""
TIER=""
SHIPS_JOURNALD=""
SHIPS_AUTH_LOGS=""
SHIPS_DISK_HEALTH=""
SEEN_DISK_HEALTH=""

while IFS= read -r line || [ -n "$line" ]; do
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
    manifest_version)
        [ -z "$MANIFEST_VERSION" ] || fail "duplicate key manifest_version"
        MANIFEST_VERSION="$val"
        ;;
    tier)
        [ -z "$TIER" ] || fail "duplicate key tier"
        TIER="$val"
        ;;
    ships_journald)
        [ -z "$SHIPS_JOURNALD" ] || fail "duplicate key ships_journald"
        SHIPS_JOURNALD="$val"
        ;;
    ships_auth_logs)
        [ -z "$SHIPS_AUTH_LOGS" ] || fail "duplicate key ships_auth_logs"
        SHIPS_AUTH_LOGS="$val"
        ;;
    ships_disk_health)
        [ -z "$SEEN_DISK_HEALTH" ] || fail "duplicate key ships_disk_health"
        SEEN_DISK_HEALTH=1
        SHIPS_DISK_HEALTH="$val"
        ;;
    *)
        fail "unknown key '$key'"
        ;;
    esac
done <"$1"

case "$MANIFEST_VERSION" in
1)
    # Version 1 predates disk health: the key is unknown there.
    [ -z "$SEEN_DISK_HEALTH" ] || fail "ships_disk_health requires manifest_version 2"
    SHIPS_DISK_HEALTH=false
    ;;
2)
    # A bool, spelled exactly true or false — a string, number or object
    # (\"true\", 1, {...}) is rejected like any other schema violation.
    case "$SHIPS_DISK_HEALTH" in true | false) ;; *) fail "ships_disk_health must be true or false" ;; esac
    ;;
*)
    fail "unsupported manifest_version '$MANIFEST_VERSION' (this agent understands 1 and 2 — update the package)"
    ;;
esac
case "$TIER" in free | pro | team) ;; *) fail "unknown tier '$TIER'" ;; esac
case "$SHIPS_JOURNALD" in true | false) ;; *) fail "ships_journald must be true or false" ;; esac
case "$SHIPS_AUTH_LOGS" in true | false) ;; *) fail "ships_auth_logs must be true or false" ;; esac
if [ "$SHIPS_AUTH_LOGS" = "true" ] && [ "$SHIPS_JOURNALD" = "false" ]; then
    fail "ships_auth_logs without ships_journald (facade never emits this shape)"
fi

# ---- local identity ---------------------------------------------------------

ETC_DIR="${CV_AGENT_ETC_DIR:-/etc/cloudviewer-agent}"
if [ -z "${CV_AGENT_TOKEN:-}" ] && [ -r "$ETC_DIR/agent.env" ]; then
    # shellcheck disable=SC1091 # written by `cloudviewer-agent enroll`
    . "$ETC_DIR/agent.env"
fi
TOKEN="${CV_AGENT_TOKEN:-}"
BASE="${CV_AGENT_FACADE_URL:-}"
[ -n "$TOKEN" ] || fail "no agent token (CV_AGENT_TOKEN or $ETC_DIR/agent.env)"
[ -n "$BASE" ] || fail "no facade URL (CV_AGENT_FACADE_URL or $ETC_DIR/agent.env)"
DATA_DIR="${CV_AGENT_DATA_DIR:-/var/lib/cloudviewer-agent}"

# Disk health renders only when the facade asks for it AND this package's
# reader is installed (the container image does not ship it, so it never
# renders there). Both keys are needed; neither supplies any string.
DISK_HEALTH=false
if [ "$SHIPS_DISK_HEALTH" = "true" ] &&
    [ -x "${CV_AGENT_LIBEXEC_DIR:-/usr/libexec/cloudviewer-agent}/disk-health-read" ]; then
    DISK_HEALTH=true
fi

# ---- render -----------------------------------------------------------------
# The redaction VRL below is pinned byte-for-byte against the facade's rule
# table (facade TestRedactVRLParity + this repo's golden fixtures): the
# same rules run again at ingest, so hosts on an older package are still
# covered server-side. Patterns write apostrophes as \x27 (a literal '
# would end the VRL raw string) and contain no $ (Vector env
# interpolation) — the quoted heredocs below preserve them verbatim.

cat <<EOF
# Cloud Viewer agent configuration — rendered locally by cloudviewer-agent
# from the facade's parameter manifest (tier: $TIER), do not edit.
# The config poller re-renders this file when the manifest changes. The
# facade sends parameters, never config or code (specs/17 §4).

data_dir: $DATA_DIR

sources:
  host_metrics:
    type: host_metrics
    collectors: [cpu, memory, disk, filesystem, load, network]
    scrape_interval_secs: 30
EOF

if [ "$SHIPS_JOURNALD" = "true" ]; then
    cat <<'EOF'

  journald_warnings:
    type: journald
    include_matches:
      PRIORITY: ["0", "1", "2", "3", "4"]
EOF
fi

if [ "$SHIPS_AUTH_LOGS" = "true" ]; then
    cat <<'EOF'

  auth_logs:
    type: file
    include:
      - /var/log/auth.log
      - /var/log/secure
EOF
fi

if [ "$DISK_HEALTH" = "true" ]; then
    # The command and interval are literals of this template (specs/44
    # §3.2): tests/run.sh pins the rendered command byte-for-byte against
    # this line. bytes framing makes one helper run one event, so the VRL
    # sees each mdstat array's lines together.
    cat <<'EOF'

  disk_health:
    type: exec
    mode: scheduled
    command: ["/usr/libexec/cloudviewer-agent/disk-health-read"]
    scheduled:
      exec_interval_secs: 300
    include_stderr: false
    decoding:
      codec: bytes
    framing:
      method: bytes
EOF
fi

if [ "$SHIPS_JOURNALD" = "true" ] || [ "$DISK_HEALTH" = "true" ]; then
    printf '\ntransforms:\n'
fi

if [ "$SHIPS_JOURNALD" = "true" ]; then
    cat <<'EOF'
  redact_journald:
    type: remap
    inputs: [journald_warnings]
    source: |
      .cv_source = "journald_warnings"
      .message = to_string(.message) ?? ""
      .message = replace(.message, r'(?i)authorization["\x27]?[ \t]*[:=][ \t]*["\x27]?(basic[ \t]+|bearer[ \t]+)?[^\s"\x27]+', "authorization: [REDACTED]")
      .message = replace(.message, r'(?i)bearer[ \t]+[A-Za-z0-9._~+/-]+=*', "bearer [REDACTED]")
      .message = replace(.message, r'(?i)password[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "password=[REDACTED]")
      .message = replace(.message, r'(?i)passwd[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "passwd=[REDACTED]")
      .message = replace(.message, r'(?i)secret[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "secret=[REDACTED]")
      .message = replace(.message, r'(?i)token[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "token=[REDACTED]")
      .message = replace(.message, r'(?i)key[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "key=[REDACTED]")
      .message = replace(.message, r'(?s)-----BEGIN[ A-Z]*PRIVATE KEY-----.*?(-----END[ A-Z]*PRIVATE KEY-----|\z)', "[REDACTED PEM]")
EOF
fi

if [ "$SHIPS_AUTH_LOGS" = "true" ]; then
    cat <<'EOF'

  redact_auth:
    type: remap
    inputs: [auth_logs]
    source: |
      .cv_source = "auth_logs"
      .message = to_string(.message) ?? ""
      .message = replace(.message, r'(?i)authorization["\x27]?[ \t]*[:=][ \t]*["\x27]?(basic[ \t]+|bearer[ \t]+)?[^\s"\x27]+', "authorization: [REDACTED]")
      .message = replace(.message, r'(?i)bearer[ \t]+[A-Za-z0-9._~+/-]+=*', "bearer [REDACTED]")
      .message = replace(.message, r'(?i)password[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "password=[REDACTED]")
      .message = replace(.message, r'(?i)passwd[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "passwd=[REDACTED]")
      .message = replace(.message, r'(?i)secret[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "secret=[REDACTED]")
      .message = replace(.message, r'(?i)token[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "token=[REDACTED]")
      .message = replace(.message, r'(?i)key[ \t]*[:=][ \t]*[^\s,;&"\x27]+', "key=[REDACTED]")
      .message = replace(.message, r'(?s)-----BEGIN[ A-Z]*PRIVATE KEY-----.*?(-----END[ A-Z]*PRIVATE KEY-----|\z)', "[REDACTED PEM]")
EOF
fi

if [ "$DISK_HEALTH" = "true" ]; then
    # Disk health (specs/44 §4), all in sandboxed VRL running as the vector
    # user: the helper's output is untrusted text. Only whole-disk device
    # names (nvme<N>, sd<x>) and md<N> arrays become labels; model and
    # serial are cut to 40 characters of [A-Za-z0-9 ._-]. One run in, one
    # event with a metrics array out (pinned by tests/vector.sh against the
    # golden fixtures); disk_health_split fans it out to one event per
    # gauge. Patterns use \z, never a dollar sign (Vector env interpolation).
    [ "$SHIPS_JOURNALD" = "true" ] && echo
    cat <<'EOF'
  disk_health_parse:
    type: remap
    inputs: [disk_health]
    drop_on_error: true
    source: |
      ts = timestamp(.timestamp) ?? now()
      metrics = []
      arrays = {}
      cur = ""
      stat_seen = false
      for_each(split(to_string(.message) ?? "", "\n")) -> |_i, line| {
        if starts_with(line, "smart\t") {
          doc = parse_json(slice!(line, 6)) ?? null
          st = doc.cloudviewer_disk_health
          # The device label: a whole-disk /dev/nvme<N> or /dev/sd<x>, from
          # smartctl's device object or, when opening failed, its argv.
          dev = string(doc.device.name) ?? string(doc.smartctl.argv[-1]) ?? ""
          dev = if match(dev, r'^/dev/(nvme[0-9]+|sd[a-z]+)\z') { slice!(dev, 5) } else { "" }
          if is_object(st) {
            if is_integer(st.time) {
              metrics = push(metrics, {"name": "disk_health_collected_timestamp_seconds", "kind": "absolute", "gauge": {"value": to_float(st.time) ?? 0.0}, "timestamp": ts})
            }
          } else if is_object(doc) && dev != "" {
            # smartctl exit status bits 1, 2 and 4: bad arguments, device
            # open failed or (with -n standby) a sleeping disk skipped, a
            # SMART command failed. No exit status is no answer either.
            # Higher bits (8 = disk failing, ...) are findings: answered.
            exit = int(doc.smartctl.exit_status) ?? 1
            up = mod(exit, 8) == 0
            upv = 0.0
            if up { upv = 1.0 }
            metrics = push(metrics, {"name": "disk_smart_up", "tags": {"device": dev}, "kind": "absolute", "gauge": {"value": upv}, "timestamp": ts})
            if up {
              if is_boolean(doc.smart_status.passed) {
                # Drop characters outside [A-Za-z0-9 ._-], then cut to 40.
                model = string(doc.model_name) ?? ""
                if model == "" { model = string(doc.scsi_model_name) ?? "" }
                model = truncate(replace(model, r'[^A-Za-z0-9 ._-]', ""), 40)
                serial = truncate(replace(string(doc.serial_number) ?? "", r'[^A-Za-z0-9 ._-]', ""), 40)
                passed = 0.0
                if doc.smart_status.passed == true { passed = 1.0 }
                metrics = push(metrics, {"name": "disk_smart_passed", "tags": {"device": dev, "model": model, "serial": serial}, "kind": "absolute", "gauge": {"value": passed}, "timestamp": ts})
              }
              # [name, raw value, scale]; a value that is not a number is
              # skipped, never guessed.
              nv = doc.nvme_smart_health_information_log
              fields = [
                ["disk_smart_critical_warning", nv.critical_warning, 1.0],
                ["disk_smart_percentage_used", nv.percentage_used, 1.0],
                ["disk_smart_available_spare_ratio", nv.available_spare, 0.01],
                ["disk_smart_available_spare_threshold_ratio", nv.available_spare_threshold, 0.01],
                ["disk_smart_media_errors", nv.media_errors, 1.0],
                ["disk_smart_written_bytes", nv.data_units_written, 512000.0],
                ["disk_smart_unsafe_shutdowns", nv.unsafe_shutdowns, 1.0],
                ["disk_smart_temperature_celsius", doc.temperature.current, 1.0],
                ["disk_smart_power_on_hours", doc.power_on_time.hours, 1.0]
              ]
              # ATA: raw counts of attributes 5/197/198, and wear from 177,
              # else 231, else 233 (normalized, 100 = new, counting down).
              w177 = -1.0
              w231 = -1.0
              w233 = -1.0
              for_each(array(doc.ata_smart_attributes.table) ?? []) -> |_j, a| {
                if a.id == 5 { fields = push(fields, ["disk_smart_reallocated_sectors", a.raw.value, 1.0]) }
                if a.id == 197 { fields = push(fields, ["disk_smart_pending_sectors", a.raw.value, 1.0]) }
                if a.id == 198 { fields = push(fields, ["disk_smart_offline_uncorrectable", a.raw.value, 1.0]) }
                if is_integer(a.value) || is_float(a.value) {
                  if a.id == 177 { w177 = to_float(a.value) ?? -1.0 }
                  if a.id == 231 { w231 = to_float(a.value) ?? -1.0 }
                  if a.id == 233 { w233 = to_float(a.value) ?? -1.0 }
                }
              }
              for_each(fields) -> |_k, f| {
                if is_integer(f[1]) || is_float(f[1]) {
                  v = (to_float(f[1]) ?? 0.0) * f[2]
                  metrics = push(metrics, {"name": f[0], "tags": {"device": dev}, "kind": "absolute", "gauge": {"value": v}, "timestamp": ts})
                }
              }
              wn = w177
              if wn < 0 { wn = w231 }
              if wn < 0 { wn = w233 }
              if wn >= 0 {
                # Worn fraction, the direction of percentage_used / 100;
                # clamped, as some firmware starts these above 100.
                wear = 1 - wn / 100
                if wear < 0 { wear = 0.0 }
                if wear > 1 { wear = 1.0 }
                metrics = push(metrics, {"name": "disk_smart_wear_ratio", "tags": {"device": dev}, "kind": "absolute", "gauge": {"value": wear}, "timestamp": ts})
              }
            }
          }
        } else if starts_with(line, "mdstat\t") {
          l = slice!(line, 7)
          if strip_whitespace(l) == "" {
            cur = ""
          } else if !match(l, r'^\s') {
            # An array's first line, `md0 : active raid1 a[0](F) b[1]`, or
            # Personalities / unused devices (not md<N>: they end an array).
            cur = ""
            hdr, err = parse_regex(l, r'^(?P<name>\S+)\s*:\s*(?P<rest>.*)')
            name = string(hdr.name) ?? ""
            if err == null && match(name, r'^md[0-9]+\z') {
              cur = name
              stat_seen = false
              # Members: (F) faulty counts as expected but not active, (S)
              # spare as neither — used when there is no [n/m] (raid0, linear).
              members = 0
              active = 0
              faulty = false
              for_each(split(string(hdr.rest) ?? "", r'\s+')) -> |_m, tok| {
                mm, merr = parse_regex(tok, r'^\S+\[[0-9]+\](\((?P<flag>[A-Z])\))?\z')
                if merr == null {
                  if mm.flag == "F" {
                    faulty = true
                    members = members + 1
                  } else if mm.flag != "S" {
                    members = members + 1
                    active = active + 1
                  }
                }
              }
              arrays = set!(arrays, [cur], {"expected": members, "active": active, "faulty": faulty, "sync": 1.0})
            }
          } else if cur != "" {
            n, err = parse_regex(l, r'\[(?P<disks>[0-9]+)/(?P<active>[0-9]+)\]')
            if err == null && !stat_seen {
              stat_seen = true
              arrays = set!(arrays, [cur, "expected"], to_int(n.disks) ?? 0)
              arrays = set!(arrays, [cur, "active"], to_int(n.active) ?? 0)
            }
            p, err = parse_regex(l, r'(resync|recovery|check|reshape|repair)\s*=\s*(?P<pct>[0-9.]+)%')
            if err == null {
              # mdstat prints one decimal: 7.4 % is 0.074, not 0.07400000000000001.
              s = round((to_float(p.pct) ?? 0.0) / 100, 4)
              if s < 0 { s = 0.0 }
              if s > 1 { s = 1.0 }
              arrays = set!(arrays, [cur, "sync"], s)
            } else if match(l, r'(resync|recovery|check|reshape|repair)\s*=\s*(DELAYED|PENDING)') {
              arrays = set!(arrays, [cur, "sync"], 0.0)
            }
          }
        }
      }
      for_each(arrays) -> |name, a| {
        dv = 0.0
        if a.faulty == true || a.active < a.expected { dv = 1.0 }
        metrics = push(metrics, {"name": "md_array_disks", "tags": {"array": name}, "kind": "absolute", "gauge": {"value": to_float(a.expected) ?? 0.0}, "timestamp": ts})
        metrics = push(metrics, {"name": "md_array_disks_active", "tags": {"array": name}, "kind": "absolute", "gauge": {"value": to_float(a.active) ?? 0.0}, "timestamp": ts})
        metrics = push(metrics, {"name": "md_array_degraded", "tags": {"array": name}, "kind": "absolute", "gauge": {"value": dv}, "timestamp": ts})
        metrics = push(metrics, {"name": "md_array_sync_ratio", "tags": {"array": name}, "kind": "absolute", "gauge": {"value": a.sync}, "timestamp": ts})
      }
      . = {"metrics": metrics}

  disk_health_split:
    type: remap
    inputs: [disk_health_parse]
    drop_on_error: true
    source: |
      . = array!(.metrics)

  disk_health_metrics:
    type: log_to_metric
    inputs: [disk_health_split]
    all_metrics: true
    metrics: []
EOF
fi

metric_inputs="[host_metrics]"
[ "$DISK_HEALTH" = "true" ] && metric_inputs="[host_metrics, disk_health_metrics]"
cat <<EOF

sinks:
  cloudviewer_metrics:
    type: http
    inputs: $metric_inputs
    uri: $BASE/v1/ingest/metrics
    method: post
    encoding:
      codec: text
    framing:
      method: newline_delimited
    request:
      headers:
        X-Agent-Token: $TOKEN
EOF

if [ "$SHIPS_JOURNALD" = "true" ]; then
    inputs="[redact_journald]"
    [ "$SHIPS_AUTH_LOGS" = "true" ] && inputs="[redact_journald, redact_auth]"
    cat <<EOF

  cloudviewer_logs:
    type: http
    inputs: $inputs
    uri: $BASE/v1/ingest/logs
    method: post
    encoding:
      codec: json
    framing:
      method: newline_delimited
    request:
      headers:
        X-Agent-Token: $TOKEN
EOF
fi
