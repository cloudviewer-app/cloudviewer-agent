{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cloudviewer-agent values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "existingSecret": { "type": "string" },
    "token": { "type": "string" },
    "enrollToken": {
      "$comment": "Fleet enrollment token (specs/12 §3) — chart-created Secret key enroll-token; the recommended credential for multi-node clusters. The template refuses token and enrollToken together.",
      "type": "string"
    },
    "facadeUrl": { "type": "string", "pattern": "^https?://" },
    "resources": { "type": "object" },
    "tolerations": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "global": {
      "$comment": "Helm's shared-values key; unused by this chart but must not fail validation.",
      "type": "object"
    }
  }
}
